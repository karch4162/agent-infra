# Wave config for brain-plugin (see wave/skills/wave/config.example.env).

# linear | jira
WAVE_TRACKER=jira

# The agent-ready queue, in the tracker's own query language. Workers and the
# refill step read it verbatim. The agent-ready label is always the human's gate.
#   linear: WAVE_QUEUE='team SPO, state Backlog, label agent-ready, unassigned'
#   jira:   (below)
WAVE_QUEUE='project = INNOV AND labels = brain-plugin AND labels = agent-ready AND statusCategory = "To Do" AND status != "On Hold" AND assignee IS EMPTY ORDER BY priority DESC'

# Only for WAVE_TRACKER=jira.
WAVE_JIRA_SITE=vendsy.atlassian.net

# Workflow state names a worker moves its issue through.
WAVE_STATE_START='In Progress'
WAVE_STATE_DONE='Validate'

# Where workers and walkers file follow-up issues (never with agent-ready).
WAVE_FILE_TO='Jira project INNOV, label brain-plugin'

# Optional. Defaults to origin/HEAD.
# WAVE_BASE=origin/main


# Scheduled waves (wave-control "Wave scheduled", weekdays 09/13/17 ET). The tick picks
# agent-ready rating:low tickets on a schedule; rating:medium only on an owner run.
WAVE_BACKLOG_WATCH=1
# Low PRs merge to main after CI, Codex review and the Grok challenge. The daily release
# PR is still the human gate on what ships in the plugin. Medium stays held.
WAVE_AUTO_MERGE=1
WAVE_BRANCH_PREFIX=karch4162/
# Claude implements most low tickets (the larger subscription); Codex every 3rd start of the day.
WAVE_CODEX_IMPLEMENT_EVERY=3
# Up to 6 starts a day here; wave-control's DAILY_TICKET_CAP (12) is the machine-wide total.
WAVE_DAILY_TICKET_CAP=6
