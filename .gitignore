# Node
node_modules/
npm-debug.log*

# graphify build artifacts (regenerated, never committed to the plugin)
graphify-out/

# OS / editor
.DS_Store
Thumbs.db
*.swp

# Local scratch — never publish harvested transcripts or session logs.
# Anchored to repo root so it doesn't swallow templates/vault-skeleton/chats/.gitkeep.
/chats/
*.local
.supervisor/

.claude/settings.local.json
.graphifyignore

# impeccable: machine paths and live-session journals stay local; config, tokens and live file list are shared
.impeccable/hook.cache.json
.impeccable/live/*
!.impeccable/live/config.json
